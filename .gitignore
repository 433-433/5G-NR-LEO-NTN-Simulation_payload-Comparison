# =============================================================================
# .gitignore for the 5G NR LEO NTN MATLAB project
# =============================================================================

# -------- MATLAB auto-saves and build junk --------
*.asv
*.autosave
*.mex*
*.slxc
slprj/
sccprj/
octave-workspace

# -------- MATLAB session state we never want committed --------
.MATLAB.mat
matlab.mat
startup.m.local

# -------- Operating-system noise --------
.DS_Store
Thumbs.db
desktop.ini
*~
.*.swp
.*.swo

# -------- IDE / editor caches --------
.vscode/
.idea/
*.sublime-workspace

# -------- Archives that shouldn't be tracked in-repo --------
# (keep the project tree flat; don't commit zipped copies of itself)
*.zip
*.tar.gz
*.rar
*.7z

# -------- Scratch / exploratory directories --------
scratch/
tmp/
tmp_*/
old/
backup/
backups/

# -------- LaTeX build artefacts (if you add the paper later) --------
*.aux
*.log
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# -------- Python / Jupyter (if you add any helper notebooks) --------
__pycache__/
*.pyc
.ipynb_checkpoints/

# -------- Large intermediate .mat files --------
# Some phases write multi-megabyte .mat files. Small ones are fine to keep;
# large ones should be regenerated by re-running the phase. If you prefer to
# track them, delete the next four lines and set up Git LFS instead.
phase1_v2/results/phase3_results.mat
phase1_v2/results/phase4_results.mat
phase4/results/phase7_section2_partial.mat
camera_ready.zip
